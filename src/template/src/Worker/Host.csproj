<Project Sdk="Microsoft.NET.Sdk.Worker">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <UserSecretsId>Genocs</UserSecretsId>
        <RootNamespace>Genocs.Library.Template.Worker</RootNamespace>
        <AssemblyName>Genocs.Library.Template.Worker</AssemblyName>
        <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
        <DockerfileContext>..\..</DockerfileContext>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="MassTransit.Extensions.DependencyInjection" Version="7.3.1" />
        <PackageReference Include="MassTransit.RabbitMQ" Version="[8.5.12]" />
        <PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" Version="1.23.0" />
        <PackageReference Include="OpenTelemetry.Exporter.Console" Version="1.20.1" />
        <PackageReference Include="Scrutor" Version="7.0.0" />
    </ItemGroup>

    <ItemGroup Label="Genocs Packages">
        <PackageReference Include="Genocs.Logging" Version="9.1.0" />
        <PackageReference Include="Genocs.Telemetry" Version="9.1.0" />
        <PackageReference Include="Genocs.Messaging.RabbitMQ" Version="9.1.0" />
        <PackageReference Include="Genocs.Persistence.MongoDB" Version="9.1.0" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Contracts\Contracts.csproj" />
        <ProjectReference Include="..\Domain\Domain.csproj" />
        <ProjectReference Include="..\Infrastructure\Infrastructure.csproj" />
    </ItemGroup>

</Project>
